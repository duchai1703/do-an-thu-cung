## 🧩 Component Patterns

### 1. Gradient Header

```jsx
const GradientHeader = ({ title, subtitle, emoji, gradient = 'dashboard' }) => {
  const gradients = {
    dashboard: 'from-indigo-500 via-purple-500 to-purple-600',
    employees: 'from-blue-500 via-cyan-500 to-teal-500',
    appointments: 'from-orange-500 via-amber-500 to-yellow-500',
    services: 'from-purple-500 via-fuchsia-500 to-pink-500',
    schedules: 'from-emerald-500 via-teal-500 to-cyan-500',
    cages: 'from-indigo-500 via-purple-500 to-violet-500',
    invoices: 'from-green-500 via-emerald-500 to-teal-500',
    pets: 'from-rose-500 via-pink-500 to-fuchsia-500',
    reports: 'from-violet-500 via-purple-500 to-fuchsia-500',
    settings: 'from-slate-500 via-gray-500 to-zinc-600',
  };

  return (
    <div className={`bg-gradient-to-r ${gradients[gradient]} text-white p-8 pb-24 shadow-lg`}>
      <div className="max-w-7xl mx-auto">
        <h1 className="text-3xl font-bold mb-2 flex items-center gap-3">
          <span className="text-4xl">{emoji}</span>
          {title}
        </h1>
        <p className="text-white/90">{subtitle}</p>
      </div>
    </div>
  );
};
```

### 2. Stats Card

```jsx
const StatsCard = ({ emoji, title, value, trend, trendUp = true }) => (
  <div className="bg-white rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
    <div className="flex items-center justify-between mb-4">
      <span className="text-3xl">{emoji}</span>
      {trend && (
        <span className={`text-sm font-medium px-2 py-1 rounded-full ${
          trendUp ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'
        }`}>
          {trendUp ? '↑' : '↓'} {trend}
        </span>
      )}
    </div>
    <p className="text-gray-500 text-sm">{title}</p>
    <p className="text-2xl font-bold text-gray-900 mt-1">{value}</p>
  </div>
);

// Usage
<StatsCard 
  emoji="💰" 
  title="Doanh thu hôm nay" 
  value="15,000,000đ" 
  trend="+12%" 
  trendUp={true} 
/>
```

### 3. Status Badge

```jsx
const StatusBadge = ({ status }) => {
  const statusConfig = {
    PENDING: { 
      emoji: '🟡', 
      label: 'Chờ xử lý', 
      bg: 'bg-amber-100', 
      text: 'text-amber-700' 
    },
    CONFIRMED: { 
      emoji: '🟢', 
      label: 'Đã xác nhận', 
      bg: 'bg-green-100', 
      text: 'text-green-700' 
    },
    IN_PROGRESS: { 
      emoji: '🔵', 
      label: 'Đang thực hiện', 
      bg: 'bg-blue-100', 
      text: 'text-blue-700' 
    },
    COMPLETED: { 
      emoji: '✅', 
      label: 'Hoàn thành', 
      bg: 'bg-emerald-100', 
      text: 'text-emerald-700' 
    },
    CANCELLED: { 
      emoji: '🔴', 
      label: 'Đã hủy', 
      bg: 'bg-red-100', 
      text: 'text-red-700' 
    },
    PAID: { 
      emoji: '💵', 
      label: 'Đã thanh toán', 
      bg: 'bg-green-100', 
      text: 'text-green-700' 
    },
  };

  const config = statusConfig[status] || statusConfig.PENDING;

  return (
    <span className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium ${config.bg} ${config.text}`}>
      <span>{config.emoji}</span>
      {config.label}
    </span>
  );
};
```

### 4. Action Button Group

```jsx
const ActionButtons = ({ onView, onEdit, onDelete }) => (
  <div className="flex items-center gap-2">
    {onView && (
      <button 
        onClick={onView}
        className="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
        title="Xem chi tiết"
      >
        👁️
      </button>
    )}
    {onEdit && (
      <button 
        onClick={onEdit}
        className="p-2 text-gray-500 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors"
        title="Chỉnh sửa"
      >
        ✏️
      </button>
    )}
    {onDelete && (
      <button 
        onClick={onDelete}
        className="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
        title="Xóa"
      >
        🗑️
      </button>
    )}
  </div>
);
```

### 5. Empty State

```jsx
const EmptyState = ({ emoji = '📭', title, description, action }) => (
  <div className="flex flex-col items-center justify-center py-16 px-4">
    <span className="text-8xl mb-6">{emoji}</span>
    <h3 className="text-xl font-semibold text-gray-900 mb-2">{title}</h3>
    <p className="text-gray-500 text-center max-w-md mb-6">{description}</p>
    {action}
  </div>
);

// Usage
<EmptyState 
  emoji="🐾"
  title="Chưa có thú cưng nào"
  description="Hãy thêm thú cưng đầu tiên để bắt đầu quản lý"
  action={<Button>➕ Thêm thú cưng</Button>}
/>
```

### 6. Search & Filter Bar

```jsx
const SearchFilterBar = ({ onSearch, filters, onAdd }) => (
  <div className="flex flex-wrap items-center gap-4 bg-white p-4 rounded-xl shadow-md">
    {/* Search */}
    <div className="flex-1 min-w-[200px] relative">
      <span className="absolute left-3 top-1/2 -translate-y-1/2">🔍</span>
      <input
        type="text"
        placeholder="Tìm kiếm..."
        className="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
        onChange={(e) => onSearch(e.target.value)}
      />
    </div>

    {/* Filters */}
    {filters?.map((filter, idx) => (
      <select 
        key={idx}
        className="px-4 py-2 border border-gray-200 rounded-lg bg-white"
      >
        <option>📂 {filter.label}</option>
        {filter.options.map(opt => (
          <option key={opt.value} value={opt.value}>{opt.label}</option>
        ))}
      </select>
    ))}

    {/* Add Button */}
    {onAdd && (
      <button 
        onClick={onAdd}
        className="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg hover:shadow-lg transition-all"
      >
        ➕ Thêm mới
      </button>
    )}
  </div>
);
```

